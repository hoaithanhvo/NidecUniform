<Window x:Class="NidecUniform.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NidecUniform"
        mc:Ignorable="d"
        Title="Nidec Uniform" Height="760" Width="1280" WindowStartupLocation="CenterScreen"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Icon="/Images/Nidec_Logo.png"
        xmlns:Menu="clr-namespace:NidecUniform.Utilities"
        xmlns:vm="clr-namespace:NidecUniform.ViewModels">
    <Window.DataContext>
        <vm:NavigationVM />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Border Background="#cfd5e5" CornerRadius="40" BorderThickness="2" BorderBrush=" #ebedf3" Padding="20" MouseDown="Border_MouseDown">
        <Border CornerRadius="40">
            <Border.Background>
                <LinearGradientBrush>
                    <GradientStop Color="#fefefe" Offset="0"/>
                    <GradientStop Color="#fefefe" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!--Left Menu-->

                <Grid HorizontalAlignment="Left" Width="170">
                    <Border Background="#039F41" CornerRadius="20,0,0,20" />
                    <StackPanel VerticalAlignment="Top">
                        <Image Source="Images/Nidec_Logo_RemoveBG.png" Width="150" Height="50" Margin="0 15 0 0"/>
                        <Border CornerRadius="12,12,12,12" Background="White" Margin="10 0">
                            <TextBlock Padding="0 5"  Text="Nidec Uniform" TextAlignment="Center" FontWeight="Bold" FontSize="20" Foreground="#039F41"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Height="400" Width="170">

                        <!--// Home //-->
                        <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding HomeCommand}" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Home" Style="{StaticResource menuButtonIcon}"/>
                                <TextBlock Text="Home" Style="{StaticResource Text_Style}" />
                            </StackPanel>
                        </Menu:Btn>

                        <!--// Import //-->
                        <Menu:Btn Style="{StaticResource BtnStyle}"
                  Command="{Binding ImportCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Import" Style="{StaticResource menuButtonIcon}"/>
                                <TextBlock Text="Import" Style="{StaticResource Text_Style}" />
                            </StackPanel>
                        </Menu:Btn>

                        <!--// Export //-->

                        <Menu:Btn Style="{StaticResource BtnStyle}"
                  Command="{Binding ExportCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="InvoiceExportOutline" Style="{StaticResource menuButtonIcon}"/>
                                <TextBlock Text="Export" Style="{StaticResource Text_Style}" />
                            </StackPanel>
                        </Menu:Btn>

                        <!--// Scan //-->
                        <Menu:Btn Style="{StaticResource BtnStyle}"
                  Command="{Binding ScanCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="QrcodeScan" Style="{StaticResource menuButtonIcon}"/>
                                <TextBlock Text="Scan" Style="{StaticResource Text_Style}" />
                            </StackPanel>
                        </Menu:Btn>
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="1">
                    <ContentControl x:Name="Pages"
                       Content="{Binding CurrentView}" />
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
  