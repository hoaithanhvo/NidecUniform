<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:NidecUniform.ViewModels"
                    xmlns:view="clr-namespace:NidecUniform.Views">
    <DataTemplate DataType="{x:Type vm:HomeVM}">
        <view:Home />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ExportVM}">
        <view:Export />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ImportVM}">
        <view:Import/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ScanVM}">
        <view:Scan/>
    </DataTemplate>
   
</ResourceDictionary>