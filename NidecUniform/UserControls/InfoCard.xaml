<UserControl x:Class="NidecUniform.UserControls.InfoCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Name="infoCard"
             >
    <Grid x:Name="grid" Margin="8 0">
        <Border CornerRadius="20" Background="#039F41" Width="60" Height="60" VerticalAlignment="Top" Margin="0 -30 0 0" Panel.ZIndex="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3" Direction="270" Color="#039F41"/>
            </Border.Effect>
            <Icon:PackIconMaterial Kind="{Binding ElementName=infoCard,Path=Icon}" Width="30" Height="30" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        
       <!--Main Section-->
        <Border Background="#039F41" CornerRadius="20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding ElementName=infoCard,Path=Title}" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 30 0 0"/>
                <TextBlock Text="{Binding ElementName=infoCard,Path=Quantity}" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 5"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
