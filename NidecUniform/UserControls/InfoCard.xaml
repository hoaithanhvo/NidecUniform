<UserControl x:Class="NidecUniform.UserControls.InfoCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Name="infoCard"
             >
    <Grid x:Name="grid" Margin="8 0">
        <Border CornerRadius="20" Background="#039F41" Width="60" Height="60" VerticalAlignment="Top" Margin="0 -30 0 0" Panel.ZIndex="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3" Direction="270" Color="#039F41"/>
            </Border.Effect>
            <Icon:PackIconMaterial Kind="{Binding ElementName=infoCard,Path=Icon}" Width="30" Height="30" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        
        <!--Purple Border-->

        <Border x:Name="border" BorderThickness="1" BorderBrush="#7163ba" CornerRadius="20" Margin="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=infoCard,Path=IsActive}" Value="True">
                            <Setter Property="Visibility"  Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
       <!--Main Section-->
        <Border Background="White" CornerRadius="20">
            <StackPanel>
                <Button Style="{StaticResource dotsButton}">
                    <Icon:PackIconMaterial Kind="DotsVertical"/>
                </Button>
                <TextBlock Text="{Binding ElementName=infoCard,Path=Title}" Foreground="Black" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 10 0 0"/>
                <TextBlock Text="{Binding ElementName=infoCard,Path=Quantity}" Foreground="Black" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 5 0 10"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
