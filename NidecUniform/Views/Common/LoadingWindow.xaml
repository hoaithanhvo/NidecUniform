<Window x:Class="NidecUniform.Views.Common.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ResizeMode="NoResize" 
        ShowInTaskbar="False" 
        WindowStartupLocation="CenterOwner">
    <Grid Background="Transparent">
        <Border Width="100" Height="100" Background="White" CornerRadius="10" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="80" Height="10" IsIndeterminate="True"/>
                <TextBlock Text="Đang tải..." HorizontalAlignment="Center" Margin="5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
