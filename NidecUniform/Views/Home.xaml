<UserControl x:Class="NidecUniform.Views.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NidecUniform.Views"
             mc:Ignorable="d" 
             d:DesignHeight="760" d:DesignWidth="1110"
            xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
            xmlns:Ivc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
            xmlns:uc="clr-namespace:NidecUniform.UserControls"
            xmlns:vm="clr-namespace:NidecUniform.ViewModels">


    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="White" Offset="0.0"/>
                <GradientStop Color="#9df6b0" Offset="0.5"/>
                <GradientStop Color="#039F41" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="5 20 25 20">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!--Title Section-->

            <Grid Grid.Column="0" Grid.ColumnSpan="3"  VerticalAlignment="Top" Margin=" 0 10 0 0">
                <StackPanel  Grid.Column="1" Margin="7 10  0 25" Orientation="Horizontal">
                    <Border  Height="35"  Background="#039F41" CornerRadius="5" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12" Foreground="White" FontWeight="SemiBold"
                   Text="Start Date" VerticalAlignment="Center" Margin="5"/>
                            <DatePicker x:Name="StartDatePicker" SelectedDate="{Binding StartDate, Mode=TwoWay}"
                    VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text=" - " VerticalAlignment="Center" />
                    <Border Height="35" Background="#039F41" CornerRadius="5" Padding="2">

                        <StackPanel Orientation="Horizontal" Background="#039F41">
                            <TextBlock FontSize="12" Foreground="White" FontWeight="SemiBold" Text="End Date" VerticalAlignment="Center" Margin="5"/>
                            <DatePicker x:Name="EndDatePicker" SelectedDate="{Binding EndDate, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Button Width="100" Height="35" Content="Search" Style="{StaticResource mainButton}" Command="{Binding SearchCommand,Mode=TwoWay}"/>

                </StackPanel>
            </Grid>
            <!--Main Middle Chart Section-->
            <Border Grid.Row="1" Grid.ColumnSpan="4" CornerRadius="30" Margin="20 0 0 0">
                <Border.Background>
                    <LinearGradientBrush>
                        <GradientStop Color="#6a5dae" Offset="0"/>
                        <GradientStop Color="#54479c" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="#6e60b5" BorderThickness="2" BorderBrush="#8276c0" CornerRadius="30" Margin=" 0 0 0 -10"/>
                    <TextBlock Text="Overview" Foreground="#f0eff6" FontSize="18" FontWeight="SemiBold" Margin="35 25 0 0"/>
                    <TextBlock Text="Monthly" Foreground="#f0eff6" FontSize="16" FontWeight="SemiBold" Margin="0 27 27 0" HorizontalAlignment="Right"/>
                    <!--Main Chart-->
                    <Ivc:CartesianChart LegendLocation="None" Margin="10">
                        <Ivc:CartesianChart.ToolTip>
                            <Ivc:DefaultTooltip Background="#5a5080" Foreground="#f4f3f6" BulletSize="0"/>
                        </Ivc:CartesianChart.ToolTip>
                        <Ivc:CartesianChart.AxisX>
                            <Ivc:Axis Foreground="#a79fd1" FontSize="14" ShowLabels="True" Labels="Jan,Feb,Mar, Apr ,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec">
                                <Ivc:Axis.Separator>
                                    <Ivc:Separator StrokeThickness="0" Step="1"/>
                                </Ivc:Axis.Separator>
                            </Ivc:Axis>
                        </Ivc:CartesianChart.AxisX>
                        <Ivc:CartesianChart.AxisY>
                            <Ivc:Axis Foreground="#a79fd1" FontSize="14" ShowLabels="False" MinValue="0" MaxValue="170">
                                <Ivc:Axis.Separator>
                                    <Ivc:Separator StrokeThickness="0"/>
                                </Ivc:Axis.Separator>
                            </Ivc:Axis>
                        </Ivc:CartesianChart.AxisY>
                        <Ivc:CartesianChart.Series>
                            <Ivc:LineSeries Fill="#7164b2" StrokeThickness="4" PointGeometrySize="0" Values="10,15,20,30,102,123,90">
                                <Ivc:LineSeries.Stroke>
                                    <LinearGradientBrush>
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#f782ab" Offset="1"/>
                                        <GradientStop Color="Transparent" Offset="2"/>
                                    </LinearGradientBrush>
                                </Ivc:LineSeries.Stroke>
                            </Ivc:LineSeries>
                        </Ivc:CartesianChart.Series>
                    </Ivc:CartesianChart>
                    <Grid Grid.Row="1" Margin="10 20 10 15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!--Text Info Cards-->
                        <uc:TextInfo TextTop="Total Time" TextMiddle="748 Hr" TextBottom="April" IsActive="False" />
                        <uc:TextInfo TextTop="Total Steps" TextMiddle="9.123 St" TextBottom="April" IsActive="True" Grid.Column="1" />
                        <uc:TextInfo TextTop="Target" TextMiddle="9200 St" TextBottom="April" IsActive="False"  Grid.Column="2"/>
                    </Grid>
                </Grid>
            </Border>

            <!--Middle Right Section-->
        </Grid>
        <!--Right Section-->
        <Border Background="White" Grid.Column="1" Grid.ColumnSpan="3" CornerRadius="0 40 40 0">
            <StackPanel >
                <!--Top TitleBar-->
                <Grid Margin="10 30 0 5">
                    <Icon:PackIconMaterial Kind="Details" Style="{StaticResource titleIcon}"/>
                    <TextBlock Text="Details Product" Margin="40 0 0 0" Style="{StaticResource titleText}"/>
                </Grid>

                <!--Tab Buttons-->
                <Separator Background="#e7e5f3" Margin="20 15" Height="0.8"/>
                <!--Users Info-->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="530">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <uc:UserCard ProductName="{Binding ProductName}" 
                         Image="{Binding Image}" 
                         Price="{Binding Price}" 
                         Quantity="{Binding Quantity}" 
                         TotalPrice="{Binding TotalPrice}" />

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <Border  CornerRadius="10" Height="125" Margin="10 25" >
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
