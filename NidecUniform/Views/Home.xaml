<UserControl x:Class="NidecUniform.Views.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NidecUniform.Views"
             mc:Ignorable="d" 
             d:DesignHeight="760" d:DesignWidth="1110"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:Ivc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:uc="clr-namespace:NidecUniform.UserControls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:NidecUniform.ViewModels">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="White" Offset="0.0"/>
                <GradientStop Color="#e3f0ef" Offset="1.5"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="230"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="0 0 0 10">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <!--Title Section-->

            <Grid Grid.Column="0" Grid.ColumnSpan="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBlock Text="Main Board" FontSize="25" FontWeight="SemiBold"  Margin="10 10 0 0" Foreground="#039F41"/>
                </Grid>
                <Grid Grid.Column="1">
                    <Border  Height="35"  Background="#039F41" CornerRadius="5" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12" Foreground="White" FontWeight="SemiBold"
   Text="Start Date" VerticalAlignment="Center" Margin="5"/>
                            <DatePicker x:Name="StartDatePicker" SelectedDate="{Binding StartDate, Mode=TwoWay}"
    VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text=" - " VerticalAlignment="Center" />
                    <Border Height="35" Background="#039F41" CornerRadius="5" Padding="2">

                        <StackPanel Orientation="Horizontal" Background="#039F41">
                            <TextBlock FontSize="12" Foreground="White" FontWeight="SemiBold" Text="End Date" VerticalAlignment="Center" Margin="5"/>
                            <DatePicker x:Name="EndDatePicker" SelectedDate="{Binding EndDate, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <!--<Button Width="100" Height="35" Content="Search" Style="{StaticResource mainButton}" Command="{Binding SearchCommand,Mode=TwoWay}"/>-->

                </Grid>

            </Grid>
            <!--Main Middle Chart Section-->
            <Grid Grid.Row="1" Grid.ColumnSpan="4"  Margin="10 0 10 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0 0 0 10">
                    <Border Background="Transparent" BorderThickness="2" BorderBrush="#039F41" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Ivc:PieChart Series="{Binding SeriesCollection}" />
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="0" Grid.Column="1">
                    <StackPanel>
                        <uc:InfoCard Title="Total Payment" Quantity="{Binding TotalAmount}" Icon="CreditCardCheckOutline" Margin="0 30 0 30"/>
                        <uc:InfoCard Title="Total User" Quantity="{Binding TotalUser}" Icon="CreditCardCheckOutline" Margin="0 30 0 30"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Grid.ColumnSpan="2">
                    <!--Main Chart-->
                    <Border Background="Transparent" BorderThickness="2" BorderBrush="#039F41" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="221*"/>
                                <ColumnDefinition Width="605*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0"  >
                                <Ivc:PieChart Grid.ColumnSpan="4" Margin="10 40 0 0">
                                    <Ivc:PieChart.Series>
                                        <Ivc:PieSeries Title="FAN" Values="20" DataLabels="True" />
                                        <Ivc:PieSeries Title="PARTS" Values="50" DataLabels="True" />
                                        <Ivc:PieSeries Title="MOTOR" Values="10" DataLabels="True" />
                                    </Ivc:PieChart.Series>
                                </Ivc:PieChart>
                            </StackPanel>
                            <TextBlock Text="Employee" Foreground="#039F41" FontSize="12" FontWeight="SemiBold" Margin="20 0 0 0"/>

                            <!--Main Chart-->
                            <Ivc:CartesianChart Grid.Row="1" Grid.ColumnSpan="2" Margin="20 0 10 0">
                                <Ivc:CartesianChart.Series>
                                    <Ivc:ColumnSeries Fill="#039F41"
                                    Values="{Binding ChartValues}"
                                    DataLabels="True">      
                                    </Ivc:ColumnSeries>
                                </Ivc:CartesianChart.Series>

                                <Ivc:CartesianChart.AxisX>
                                    <Ivc:Axis Foreground="Black"  Labels="{Binding ProductLabels}">
                                    </Ivc:Axis>
                                </Ivc:CartesianChart.AxisX>

                                <Ivc:CartesianChart.AxisY>
                                    <Ivc:Axis Foreground="Black" MinValue="0" MaxValue="20"/>
                                </Ivc:CartesianChart.AxisY>
                            </Ivc:CartesianChart>

                            <TextBlock Grid.ColumnSpan="2" Grid.Row="2" Text="Deparment" Margin="0 0 20 0" Foreground="#039F41" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>

                    </Border>
                </Grid>
            </Grid>

            <!--Middle Right Section-->
        </Grid>
        <!--Right Section-->
        <Border Background="Transparent" Grid.Column="1" Grid.ColumnSpan="3" CornerRadius="0 40 40 0">
            <StackPanel >
                <!--Top TitleBar-->
                <Grid Margin="10 10 0 5">
                    <TextBlock TextAlignment="Center" Text="Details Product"  Style="{StaticResource titleText}"/>
                </Grid>
                <!--Tab Buttons-->
                <Separator Background="#039F41" Margin="20 0" Height="0.8"/>
                <!--Users Info-->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="600">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <uc:UserCard ProductName="{Binding ProductName}" 
                         Image="{Binding Image}" 
                         Price="{Binding Price}" 
                         Quantity="{Binding Quantity}" 
                         TotalPrice="{Binding TotalPrice}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
